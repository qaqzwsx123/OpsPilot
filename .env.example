# 真实 LLM（支持 OpenAI、DeepSeek 等 /chat/completions 兼容服务）
SAFE_SQL_AGENT_LLM_BASE_URL=https://api.openai.com/v1
SAFE_SQL_AGENT_LLM_API_KEY=replace_me
SAFE_SQL_AGENT_LLM_MODEL=gpt-4o-mini

# 默认 false。仅在本地 Demo 明确需要展示“审批后执行”时改为 true。
SAFE_SQL_AGENT_ALLOW_APPROVED_WRITES=false

# 可选：配置后，受控 SELECT 将执行在真实 MySQL；审计、知识库和本地记忆仍默认留在 SQLite。
# SAFE_SQL_AGENT_MYSQL_URL=mysql://readonly_user:password@127.0.0.1:3306/ops
